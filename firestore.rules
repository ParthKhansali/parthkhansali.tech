rules_version = '2';

/**
 * Firestore rules for parthkhansali.tech.
 *
 * The lounge wall is the only collection the browser writes to. It is open to
 * read (it is a public noticeboard) and tightly constrained on create: fixed
 * field set, length caps, no links, and a server timestamp the client cannot
 * forge. Nothing is editable or deletable from the client, so a posted message
 * cannot be rewritten afterwards.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    match /lounge_messages/{messageId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'text', 'clientId', 'createdAt'])
        && isText(request.resource.data.name, 1, 24)
        && isText(request.resource.data.text, 2, 280)
        && isText(request.resource.data.clientId, 1, 64)
        && request.resource.data.createdAt == request.time
        && !request.resource.data.text.matches('(?i).*(https?://|www\\.).*');

      // No edits and no deletes from the client. Moderation happens in the
      // Firebase console, where it is deliberate and logged.
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
